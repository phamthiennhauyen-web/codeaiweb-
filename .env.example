# Copy file này thành .env
# LƯU Ý: cấu hình gửi mail (Gmail + App Password) nay làm trên web tại /setup.html
# nên .env chỉ cần PORT và JWT_SECRET là đủ.

PORT=3000

# Chuỗi bí mật ký token - đổi thành chuỗi dài ngẫu nhiên
JWT_SECRET=change_this_to_a_long_random_string

# (Tùy chọn, ít dùng) Cấu hình gửi mail bằng file, thay cho /setup.html:
# GMAIL_USER=your.email@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
